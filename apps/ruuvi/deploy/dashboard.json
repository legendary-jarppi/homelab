          },
          "expr": "ruuvi_temperature_celsius{name=~\"$tag\"}",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "decimals": 1,
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 0,
