# Build: apps/climate/deploy.sh. Node 22 runs the TypeScript sources directly (type stripping);
# no runtime dependencies.
FROM docker.io/library/node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=8080 NODE_NO_WARNINGS=1
COPY package.json ./
COPY src ./src
USER node
EXPOSE 8080
CMD ["node", "src/main.ts"]
