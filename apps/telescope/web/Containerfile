# Build: apps/telescope/web/deploy.sh (podman build -t localhost/telescope-web:<tag> apps/telescope/web).
FROM docker.io/library/node:22-alpine AS build
WORKDIR /app
COPY package.json package-lock.json ./
RUN npm ci --no-fund --no-audit
COPY . .
RUN npm run build

# adapter-node bundles all dependencies (all are devDependencies) into build/; no node_modules at runtime.
FROM docker.io/library/node:22-alpine
WORKDIR /app
ENV NODE_ENV=production PORT=3000
COPY --from=build /app/build ./build
COPY package.json ./
USER node
EXPOSE 3000
CMD ["node", "build/index.js"]
